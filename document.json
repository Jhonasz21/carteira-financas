dade, estado e CEP. Pode também trazer o identificador único de cada endereço para facilitar consultas futuras.\n- **Uso comum**: Utilizado para exibir endereços cadastrados para entrega de novos cartões por exemplo.","operationId":"GET_/v1/enderecos/:CNPJ","parameters":[{"description":"Token de autenticação","in":"header","name":"Authorization","required":true,"schema":{"type":"string"}},{"description":"CNPJ do grupo","in":"header","name":"CnpjGrupoEconomico","required":true,"schema":{"type":"string"}},{"in":"header","name":"Accept","schema":{"type":"string"}},{"in":"path","name":"CNPJ","required":true,"schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/Endereco"},"type":"array"}},"application/xml":{"schema":{"items":{"$ref":"#/components/schemas/Endereco"},"type":"array"}}},"description":"OK"},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPError"}},"application/xml":{"schema":{"$ref":"#/components/schemas/HTTPError"}}},"description":"Bad Request _(validation or deserialization error)_"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPError"}},"application/xml":{"schema":{"$ref":"#/components/schemas/HTTPError"}}},"description":"Internal Server Error _(panics)_"},"default":{"description":""}},"summary":"Listar Endereços","tags":["Endereços"]}},"/v1/funcionarios/":{"get":{"description":"\n- **Descrição:** Recupera uma lista de todos os funcionários cadastrados no sistema. Suporta parâmetro opcional de\n\tfiltro (como nome e cpf), status e paginação para facilitar a navegação em grandes volumes de dados.\n- **Uso comum:** Visualização geral da base de colaboradores, integração com sistemas de RH ou BI.","operationId":"GET_/v1/funcionarios/","parameters":[{"description":"Token de autenticação","in":"header","name":"Authorization","required":true,"schema":{"type":"string"}},{"description":"CNPJ do grupo","in":"header","name":"Cn