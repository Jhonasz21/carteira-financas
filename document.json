scription":"CNPJ do grupo","in":"header","name":"CnpjGrupoEconomico","required":true,"schema":{"type":"string"}},{"description":"Número de compras por página para paginação","in":"query","name":"tamanho_pagina","schema":{"default":20,"type":"integer"}},{"description":"Cursor para paginação, indicando a partir de qual compra continuar a listagem","in":"query","name":"cursor","schema":{"default":0,"type":"integer"}},{"description":"Indica se compras canceladas devem ser incluídas na listagem","in":"query","name":"incluir_canceladas","schema":{"default":false,"type":"boolean"}},{"in":"header","name":"Accept","schema":{"type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/Compra"},"type":"array"}},"application/xml":{"schema":{"items":{"$ref":"#/components/schemas/Compra"},"type":"array"}}},"description":"OK"},"400":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPError"}},"application/xml":{"schema":{"$ref":"#/components/schemas/HTTPError"}}},"description":"Bad Request _(validation or deserialization error)_"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPError"}},"application/xml":{"schema":{"$ref":"#/components/schemas/HTTPError"}}},"description":"Internal Server Error _(panics)_"},"default":{"description":""}},"summary":"Todas as compras","tags":["Compras"]},"post":{"description":"\n- **Descrição:** Registra um nova compra no sistema. O corpo da requisição deve conter os dados do cliente, lista de\n\titens e forma de pagamento\n- **Uso comum:** Possibilitar a geração de novos pedidos na plataforma.","operationId":"POST_/v1/compras/","parameters":[{"description":"Token de autenticação","in":"header","name":"Authorization","required":true,"schema":{"type":"string"}},{"description":"CNPJ do grupo","in":"header","name":"CnpjGrupoEconomico","required":true,"schema":{"type":"string"}},{"in":"header","name":"Accept","schema":{"type":"string"}}],"reque